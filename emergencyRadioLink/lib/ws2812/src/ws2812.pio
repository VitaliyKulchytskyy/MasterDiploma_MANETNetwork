;
; Timing program transcribed verbatim from raspberrypi/pico-examples (pio/ws2812/ws2812.pio).
; The C-side state machine setup and byte-order handling live in ws2812.c instead of here.
.pio_version 0 // only requires PIO version 0

.program ws2812
.side_set 1

; Constants selected for broad compatibility with WS2812, WS2812B, and SK6812 LEDs.
.define public T1 3
.define public T2 3
.define public T3 4

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1] ; Side-set still takes place when instruction stalls
    jmp !x do_zero side 1 [T1 - 1] ; Branch on the bit we shifted out. Positive pulse
do_one:
    jmp  bitloop   side 1 [T2 - 1] ; Continue driving high, for a long pulse
do_zero:
    nop            side 0 [T2 - 1] ; Or drive low, for a short pulse
.wrap
