# Installed as /etc/udev/rules.d/90-erl-mesh.rules
# (Re)start the mesh when the Wi-Fi dongle appears (replug, late probe),
# but only on boards where the mesh is enabled at boot (just mesh-enable)
# (match DEVTYPE, not KERNEL=="wlx*": at "add" the kernel name is still wlan0)
ACTION=="add", SUBSYSTEM=="net", ENV{DEVTYPE}=="wlan", RUN+="/bin/sh -c 'systemctl -q is-enabled mesh.service && systemctl --no-block restart mesh.service'"
