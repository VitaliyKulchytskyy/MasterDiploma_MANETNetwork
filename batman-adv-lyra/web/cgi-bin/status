#!/bin/sh
# JSON status of this node and the mesh, polled by the web UI
echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

MESH_IF=$(batctl if 2>/dev/null | head -n1 | cut -d: -f1)
[ -n "$MESH_IF" ] || MESH_IF=$(ls /sys/class/net | grep '^wlx' | head -n1)

node_ip=$(ip -4 -o addr show bat0 2>/dev/null | awk '{print $4}' | head -n1)
bat_mac=$(cat /sys/class/net/bat0/address 2>/dev/null)
iw_info=$(iw dev "$MESH_IF" info 2>/dev/null)
ssid=$(echo "$iw_info" | awk '/ssid/ {print $2}')
mode=$(echo "$iw_info" | awk '/type/ {print $2}')
chan=$(echo "$iw_info" | awk '/channel/ {print $2}')
freq=$(echo "$iw_info" | awk '/channel/ {gsub(/\(/, "", $3); print $3}')
txpower=$(echo "$iw_info" | awk '/txpower/ {print $2}')
gw_mode=$(batctl gw_mode 2>/dev/null | awk '{print $1}')
uptime=$(cut -d' ' -f1 /proc/uptime)
load=$(cut -d' ' -f1 /proc/loadavg)
mem_total=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
mem_avail=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)

# Neighbours: nodes heard directly
neighbours=$(batctl n -H 2>/dev/null | awk '
	{ gsub(/s$/, "", $3); printf "%s{\"mac\":\"%s\",\"if\":\"%s\",\"last_seen\":%s}", sep, $2, $1, $3; sep = "," }')

# Originators: every node reachable in the mesh, with best next hop and link quality (TQ 0-255).
# IP comes from the node's bat0 MAC (translation table) matched against the ARP cache.
tg=$(batctl tg -H 2>/dev/null)
# One IP per MAC: the cache keeps a node's old addresses (a changed mesh IP, an old DHCP lease)
# next to its current one, so take the entry in the best state (REACHABLE, then DELAY/PROBE,
# then STALE), and of those the one confirmed last ("used a/b/c": b = seconds since confirmed).
# Same "ip ... lladdr mac" lines as ip neigh, for the lookups below.
neigh=$(ip -s neigh show dev bat0 2>/dev/null | awk '
	{
		mac = ""; used = ""
		for (j = 1; j < NF; j++) {
			if ($j == "lladdr") mac = $(j + 1)
			if ($j == "used") used = $(j + 1)
		}
		if (mac == "") next
		state = $NF
		rank = (state == "REACHABLE" || state == "PERMANENT" || state == "NOARP") ? 0 \
			: (state == "DELAY" || state == "PROBE") ? 1 : (state == "STALE") ? 2 : -1
		if (rank < 0) next
		split(used, u, "/"); age = u[2] + 0
		if (!(mac in best) || rank < brank[mac] || (rank == brank[mac] && age < bage[mac])) {
			best[mac] = $1; brank[mac] = rank; bage[mac] = age
		}
	}
	END { for (mac in best) print best[mac], "lladdr", mac }')
# The board's mawk has no regex intervals ({n}), so the MAC pattern is spelled out
originators=$(batctl o -H 2>/dev/null | awk -v tg="$tg" -v neigh="$neigh" '
	BEGIN {
		hex = "[0-9a-f][0-9a-f]"
		macre = "^" hex ":" hex ":" hex ":" hex ":" hex ":" hex "$"
		n = split(tg, lines, "\n")
		for (i = 1; i <= n; i++) {
			m = split(lines[i], f, " ")
			client = ""; orig = ""
			for (j = 1; j <= m; j++)
				if (f[j] ~ macre) {
					if (client == "") client = f[j]; else orig = f[j]
				}
			if (client != "" && orig != "" && client !~ /^(01|33):/) owner[orig] = client
		}
		n = split(neigh, lines, "\n")
		for (i = 1; i <= n; i++) {
			m = split(lines[i], f, " ")
			for (j = 1; j < m; j++) if (f[j] == "lladdr") ipof[f[j + 1]] = f[1]
		}
	}
	$1 == "*" {
		gsub(/s$/, "", $3)
		tq = $0; sub(/.*\( */, "", tq); sub(/\).*/, "", tq)
		mac = $2; client = owner[mac]; ip = (client in ipof) ? ipof[client] : ""
		nexthop = $(NF - 1); iface = $NF; gsub(/[][]/, "", iface)
		printf "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"last_seen\":%s,\"tq\":%d,\"nexthop\":\"%s\",\"direct\":%s,\"if\":\"%s\"}",
			sep, mac, ip, $3, tq, nexthop, (nexthop == mac ? "true" : "false"), iface
		sep = ","
	}')

# Gateways batman-adv knows, with the mesh IP when the node has talked to it (same
# originator -> bat0 MAC -> ARP mapping as above); "selected" is the one in use.
gateways=$(batctl gwl -H 2>/dev/null | awk -v tg="$tg" -v neigh="$neigh" '
	BEGIN {
		hex = "[0-9a-f][0-9a-f]"
		macre = "^" hex ":" hex ":" hex ":" hex ":" hex ":" hex "$"
		n = split(tg, lines, "\n")
		for (i = 1; i <= n; i++) {
			m = split(lines[i], f, " ")
			client = ""; orig = ""
			for (j = 1; j <= m; j++)
				if (f[j] ~ macre) {
					if (client == "") client = f[j]; else orig = f[j]
				}
			if (client != "" && orig != "" && client !~ /^(01|33):/) owner[orig] = client
		}
		n = split(neigh, lines, "\n")
		for (i = 1; i <= n; i++) {
			m = split(lines[i], f, " ")
			for (j = 1; j < m; j++) if (f[j] == "lladdr") ipof[f[j + 1]] = f[1]
		}
	}
	{
		sel = ($1 == "*"); if (sel) $1 = ""
		split($0, f, " ")
		mac = f[1]; client = owner[mac]; ip = (client in ipof) ? ipof[client] : ""
		printf "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"selected\":%s}", sep, mac, ip, (sel ? "true" : "false")
		sep = ","
	}')

cat <<EOF
{
  "hostname": "$(hostname)",
  "kernel": "$(uname -r)",
  "uptime": ${uptime:-0},
  "load": ${load:-0},
  "mem_total_kb": ${mem_total:-0},
  "mem_avail_kb": ${mem_avail:-0},
  "mesh": {
    "if": "$MESH_IF",
    "mode": "$mode",
    "ssid": "$ssid",
    "channel": ${chan:-null},
    "freq": ${freq:-null},
    "txpower_dbm": ${txpower:-null},
    "ip": "$node_ip",
    "bat0_mac": "$bat_mac",
    "gw_mode": "$gw_mode"
  },
  "neighbours": [${neighbours}],
  "originators": [${originators}],
  "gateways": [${gateways}]
}
EOF
